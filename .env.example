# ========================================
# AWS Configuration
# ========================================
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=amzn-s3-oratorai
AWS_SQS_ASR_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/676267940025/oratorai-asr-queue

# ========================================
# Node API Configuration
# ========================================
NODE_API_URL=http://localhost:8080
WEBHOOK_SECRET=your_webhook_secret_here
WEBHOOK_ENDPOINT=/api/v1/webhooks/asr-complete

# ========================================
# ASR Configuration
# ========================================
# ASR Engine: whisper, google, azure
ASR_ENGINE=whisper

# Whisper Configuration
WHISPER_MODEL=base  # tiny, base, small, medium, large, large-v2, large-v3
WHISPER_LANGUAGE=vi  # Vietnamese
WHISPER_DEVICE=cpu  # cpu or cuda (for GPU)
WHISPER_COMPUTE_TYPE=int8  # int8, float16, float32

# Google Speech API (if using)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json
# GOOGLE_SPEECH_LANGUAGE=vi-VN

# Azure Speech Services (if using)
# AZURE_SPEECH_KEY=your_azure_key
# AZURE_SPEECH_REGION=southeastasia
# AZURE_SPEECH_LANGUAGE=vi-VN

# ========================================
# Speaker Diarization Configuration
# ========================================
DIARIZATION_ENABLED=true
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
MIN_SPEAKERS=1
MAX_SPEAKERS=5
HUGGINGFACE_TOKEN=your_huggingface_token  # Required for pyannote models

# ========================================
# Worker Configuration
# ========================================
# SQS Polling
POLL_INTERVAL=5  # seconds between polls
MAX_MESSAGES=1  # max messages to fetch per poll
VISIBILITY_TIMEOUT=300  # seconds (5 minutes)
WAIT_TIME_SECONDS=20  # long polling

# Processing
MAX_WORKERS=1  # number of concurrent workers
MAX_RETRIES=3  # max retry attempts for failed jobs
RETRY_DELAY=5  # seconds between retries

# Timeouts
DOWNLOAD_TIMEOUT=300  # seconds (5 minutes)
PROCESSING_TIMEOUT=600  # seconds (10 minutes)
WEBHOOK_TIMEOUT=30  # seconds

# ========================================
# Logging Configuration
# ========================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json or text
LOG_FILE=logs/asr-worker.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# ========================================
# Performance Tuning
# ========================================
# Audio Processing
CHUNK_SIZE=8192  # bytes for file downloads
TEMP_DIR=temp  # temporary file directory
CLEANUP_TEMP_FILES=true

# Memory Management
MAX_AUDIO_LENGTH=3600  # seconds (1 hour max)
AUDIO_SAMPLE_RATE=16000  # Hz

# ========================================
# Development/Debug
# ========================================
DEBUG=false
DRY_RUN=false  # if true, don't send webhook or delete messages
MOCK_ASR=false  # use mock data instead of real ASR
